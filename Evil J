-- Helper Function: Button Creator
local function createEvilButton(label, layoutOrder, onClick)
local btn = Instance.new("TextButton")
btn.Size = UDim2.new(1, 0, 0, 42)
btn.BackgroundColor3 = Color3.fromRGB(25, 18, 24)
btn.Text = label
btn.TextColor3 = Color3.fromRGB(240, 240, 240)
btn.Font = Enum.Font.GothamBold
btn.TextSize = 13
btn.LayoutOrder = layoutOrder
btn.AutoButtonColor = false
btn.BorderSizePixel = 0
btn.Parent = container
local btnCorner = Instance.new("UICorner")
btnCorner.CornerRadius = UDim.new(0, 6)
btnCorner.Parent = btn
local btnStroke = Instance.new("UIStroke")
btnStroke.Color = Color3.fromRGB(60, 30, 40)
btnStroke.Thickness = 1
btnStroke.Parent = btn
btn.MouseEnter:Connect(function()
TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(45, 22, 32)}):Play()
TweenService:Create(btnStroke, TweenInfo.new(0.15), {Color = Color3.fromRGB(255, 30, 55)}):Play()
end)
btn.MouseLeave:Connect(function()
TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(25, 18, 24)}):Play()
TweenService:Create(btnStroke, TweenInfo.new(0.15), {Color = Color3.fromRGB(60, 30, 40)}):Play()
end)
btn.MouseButton1Click:Connect(onClick)
return btn, btnStroke
end
-- =================================================================
-- FEATURE 1: GOD MODE
-- =================================================================
local godBtn, godStroke = createEvilButton("🛡️ GOD MODE: OFF", 1, function() end)
local function enforceGodMode()
if not isGodModeEnabled then return end
local char = localPlayer.Character
if char then
local hum = char:FindFirstChildOfClass("Humanoid")
if hum then
hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
if hum.Health < 999999 then
hum.MaxHealth = 999999
hum.Health = 999999
end
end
end
end
RunService.RenderStepped:Connect(function()
if isGodModeEnabled then
enforceGodMode()
end
end)
godBtn.MouseButton1Click:Connect(function()
isGodModeEnabled = not isGodModeEnabled
if isGodModeEnabled then
godBtn.Text = "🛡️ GOD MODE: ENABLED"
godBtn.TextColor3 = Color3.fromRGB(255, 50, 70)
enforceGodMode()
sendNotification("God Mode Activated!")
else
godBtn.Text = "🛡️ GOD MODE: OFF"
godBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
local char = localPlayer.Character
if char then
local hum = char:FindFirstChildOfClass("Humanoid")
if hum then
hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
hum.MaxHealth = 100
hum.Health = 100
end
end
sendNotification("God Mode Disabled.")
end
end)
-- =================================================================
-- FEATURE 2: UNLIMITED ITEMS
-- =================================================================
local itemBtn, itemStroke = createEvilButton("🎒 UNLIMITED ITEMS: OFF", 2, function() end)
local function monitorBackpack()
local backpack = localPlayer:WaitForChild("Backpack")
backpack.ChildRemoved:Connect(function(child)
if isInfiniteItemsEnabled and child:IsA("Tool") then
task.wait(0.05)
if not backpack:FindFirstChild(child.Name) and localPlayer.Character and not localPlayer.Character:FindFirstChild(child.Name) then
local clone = child:Clone()
clone.Parent = backpack
end
end
end)
end
task.spawn(monitorBackpack)
itemBtn.MouseButton1Click:Connect(function()
isInfiniteItemsEnabled = not isInfiniteItemsEnabled
if isInfiniteItemsEnabled then
itemBtn.Text = "🎒 UNLIMITED ITEMS: ENABLED"
itemBtn.TextColor3 = Color3.fromRGB(255, 50, 70)
sendNotification("Unlimited Items Enabled!")
else
itemBtn.Text = "🎒 UNLIMITED ITEMS: OFF"
itemBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
sendNotification("Unlimited Items Disabled.")
end
end)
-- =================================================================
-- FEATURE 3: SPAWN EVIL J BOOK
-- =================================================================
local function createEvilJBook(customName)
local tool = Instance.new("Tool")
tool.Name = customName or "Evil J Book"
tool.RequiresHandle = false
tool.CanBeDropped = true
local handle = Instance.new("Part")
handle.Name = "Handle"
handle.Size = Vector3.new(1.2, 1.6, 0.3)
handle.Color = Color3.fromRGB(180, 0, 30)
handle.Material = Enum.Material.Neon
handle.CanCollide = false
handle.Massless = true
handle.Parent = tool
local selection = Instance.new("SelectionBox")
selection.Color3 = Color3.fromRGB(255, 30, 30)
selection.Adornee = handle
selection.Parent = handle
tool.Activated:Connect(function()
sendNotification("Opened: " .. tool.Name)
end)
return tool
end
createEvilButton("📖 SPAWN EVIL J BOOK", 3, function()
local backpack = localPlayer:FindFirstChildOfClass("Backpack")
if backpack then
local book = createEvilJBook("Evil J Book")
book.Parent = backpack
sendNotification("Spawned Evil J Book!")
end
end)
